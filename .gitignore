# ==============================================================================
# F1 Simulation Racing - .gitignore
# ==============================================================================

# --- Project Specific & Standalone Builds ---
graphify-out/
Build/
Builds/
installer/
dist/
build/
*.log
*.lnk
unity_build.log
unity_verify.log
unity_batch_check.log
unity_create.log
unity_test.log

# Agent state management (track PROJECT_STATE.md, ignore teamwork logs)
.agents/*
!.agents/PROJECT_STATE.md

# Temporary test scripts
check_geometry.py
inspect_barriers.py
inspect_monza.py

# Large binary 3D assets (>100MB exceeds GitHub hard push limits)
*.fbx
*.fbx.meta
UnityF1/Assets/Models/**/source/

# Executables & native binaries
*.exe
*.dll

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/

# --- Unity ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
UnityF1/[Ll]ibrary/
UnityF1/[Tt]emp/
UnityF1/[Oo]bj/
UnityF1/[Bb]uild/
UnityF1/[Bb]uilds/
UnityF1/[Ll]ogs/
UnityF1/[Uu]ser[Ss]ettings/

# Asset meta files for directories that should not be tracked
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Aa]ssetStoreTools.meta

# Visual Studio / Rider / VS Code cache & generated files
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler & crash logs
sysinfo.txt
*.stackdump
crashlytics-build.properties
